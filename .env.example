# ---- Public address (no trailing slash). Used to build the links sent by SMS.
APP_URL=https://jc.centreespoir.ca
APP_NAME=Surplus
# Which audience this instance serves: jc (the church network) or spp (the
# Système de Prévention de Pertes, for food banks). Only the wording differs.
# On the VPS the spp container overrides this in docker-compose.yml; this file
# is the church platform's.
BRAND=jc
TIMEZONE=America/Toronto
DEFAULT_LANG=fr

# ---- Twilio (Console → Account info). Keep this file private; never commit it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Canadian local number you own, in E.164, e.g. +18195551234
TWILIO_FROM=
# Set to 1 to simulate SMS (logged, not sent) while testing
SMS_DRY_RUN=0

# ---- Email notices to the Centre (Resend). One message per reservation, in
# French, to the addresses in MAIL_TO. Leave MAIL_TO empty and nothing is sent.
# The key is at resend.com → API Keys; centreespoir.ca is already a verified
# sending domain there. MAIL_FROM must be on that domain.
RESEND_API_KEY=
MAIL_FROM=Surplus Centre Espoir <notifications@centreespoir.ca>
MAIL_TO=direction@centreespoir.ca,communications@centreespoir.ca
# Set to 1 to log the emails instead of sending them
MAIL_DRY_RUN=0

# ---- Optional
# Random secret for cookies/codes. Generated automatically on first start if empty.
APP_SECRET=
COOLDOWN_MINUTES=15
# The first administrator of a brand-new database, created at boot so standing
# up an instance never needs a terminal. Ignored as soon as one administrator
# exists, so it is safe to leave here.
ADMIN_PHONE=
ADMIN_FIRST=
ADMIN_LAST=
ADMIN_ORG=
ADMIN_FRESH_HOURS=12
SESSION_DAYS=90
